{
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 80,
  "plugins": [
    "prettier-plugin-tailwindcss",
    "@ianvs/prettier-plugin-sort-imports"
  ],
  "importOrder": [
    "^node:",
    "<THIRD_PARTY_MODULES>",
    "^@/generated/(.*)$",
    "",
    "^@/features/(.*)$",
    "^@/components/(.*)$",
    "^@/hooks/(.*)$",
    "^@/lib/(.*)$",
    "^@/server/(.*)$",
    "^@/types/(.*)$",
    "",
    "^(.*)$"
  ],
  "importOrderCaseSensitive": true,
  "tailwindFunctions": ["cn", "cva"]
}
